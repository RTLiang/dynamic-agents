#!/bin/bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
helpers="$root/.cursor/skills/verify-dynamic-agents/helpers"
action="${1:-}"; run="${2:-}"
[[ "$run" =~ ^[a-z0-9]{1,32}$ ]] || { echo 'Use control <launch|doctor|snapshot|hooks|settings|menu|press|cleanup> <owned-run-id>' >&2; exit 2; }
scratch="$root/.build/verify-dynamic-agents/$run"
evidence="$root/.build/verify-dynamic-agents-evidence/$run"
app="$scratch/DynamicAgents.app"
host="$scratch/Host.app"
bundle="dev.local.dynamicagents.verify$run"
mkdir -p "$root/.build/verify-dynamic-agents" "$root/.build/verify-dynamic-agents-evidence"
cleanup() {
  [[ ! -L "$scratch" ]] || { echo 'Refusing symlinked scratch' >&2; return 1; }
  [[ -d "$scratch" ]] || return 0
  [[ -f "$scratch/bundle-id" && "$(<"$scratch/bundle-id")" == "$bundle" ]] || { echo 'Ownership mismatch' >&2; return 1; }
  for kind in pid host-pid; do
    [[ -f "$scratch/$kind" ]] || continue
    local recorded expected current
    recorded="$(<"$scratch/$kind")"
    expected="$app/Contents/MacOS/DynamicAgents"
    [[ "$kind" != host-pid ]] || expected="$host/Contents/MacOS/Host"
    current="$(ps -p "$recorded" -o comm= 2>/dev/null || true)"
    if [[ "$current" == "$expected" ]]; then
      kill -TERM "$recorded"
      for _ in $(seq 1 40); do [[ "$(ps -p "$recorded" -o comm= 2>/dev/null || true)" == "$expected" ]] || break; sleep 0.1; done
      [[ "$(ps -p "$recorded" -o comm= 2>/dev/null || true)" != "$expected" ]] || { echo 'Owned process did not stop' >&2; return 1; }
    elif kill -0 "$recorded" 2>/dev/null; then echo 'PID reused; refusing cleanup' >&2; return 1; fi
  done
  [[ ! -f "$scratch/host-state.json" ]] || cp "$scratch/host-state.json" "$evidence/host-final.json"
  defaults delete "$bundle" >/dev/null 2>&1 || true
  defaults delete "$bundle.host" >/dev/null 2>&1 || true
  trash "$scratch"
  echo "Cleaned owned apps; evidence retained: $evidence"
}
case "$action" in
 launch)
  [[ ! -e "$scratch" && ! -e "$evidence" ]] || { echo 'Choose a fresh run ID' >&2; exit 1; }
  language="${VERIFY_LANGUAGE:-en}"
  [[ "$language" == en || "$language" == zh-Hans ]] || exit 2
  mkdir -p "$scratch" "$evidence"
  printf '%s\n' "$bundle" > "$scratch/bundle-id"
  printf '%s\n' "$language" > "$scratch/language"
  trap 'status=$?; if [[ $status != 0 ]]; then cleanup >&2; fi' EXIT
  swift build --build-system native -c debug -j 4 > "$evidence/build.log" 2>&1
  bin="$(swift build --build-system native -c debug --show-bin-path)"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$host/Contents/MacOS"
  cp "$bin/DynamicAgents" "$app/Contents/MacOS/DynamicAgents"
  cp "$root/Resources/Info.plist" "$app/Contents/Info.plist"
  ditto "$bin/DynamicAgents_AgentCore.bundle" "$app/Contents/Resources/DynamicAgents_AgentCore.bundle"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $bundle" "$app/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c 'Set :NSSupportsLiveActivities false' "$app/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c 'Set :LSMinimumSystemVersion 15.0' "$app/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c 'Delete :CFBundleURLTypes' "$app/Contents/Info.plist"
  swiftc -parse-as-library "$helpers/host.swift" -o "$host/Contents/MacOS/Host" > "$evidence/host-build.log" 2>&1
  python3 - "$host/Contents/Info.plist" "$bundle.host" <<'PY'
import plistlib,sys
from pathlib import Path
Path(sys.argv[1]).write_bytes(plistlib.dumps({'CFBundleIdentifier':sys.argv[2],'CFBundleExecutable':'Host','CFBundleName':'Verification Host','CFBundlePackageType':'APPL','LSUIElement':False}))
PY
  codesign --force --sign - "$host" > "$evidence/codesign.log" 2>&1
  codesign --force --sign - "$app" >> "$evidence/codesign.log" 2>&1
  swiftc "$helpers/ax.swift" -o "$scratch/ax" > "$evidence/ax-build.log" 2>&1
  export DYNAMIC_AGENTS_DATA_DIR="$scratch/desktop-data" DYNAMIC_AGENTS_CONFIG_HOME="$scratch/config" VERIFY_LANGUAGE="$language"
  swift "$helpers/launch.swift" "$host" "$scratch" > "$scratch/host-pid" 2> "$evidence/host-launch.log"
  swift "$helpers/launch.swift" "$app" > "$scratch/pid" 2> "$evidence/app-launch.log"
  "$0" doctor "$run" | tee "$evidence/doctor.txt"
  ;;
 doctor|snapshot|hooks|settings|menu|press)
  [[ -f "$scratch/pid" && -x "$scratch/ax" ]] || { echo 'Launch an owned run first' >&2; exit 1; }
  pid="$(<"$scratch/pid")"
  [[ "$(ps -p "$pid" -o comm= 2>/dev/null || true)" == "$app/Contents/MacOS/DynamicAgents" ]] || { echo 'Owned app not running' >&2; exit 1; }
  "$scratch/ax" "$pid" "$bundle" "$action" "$(<"$scratch/language")" "$scratch" "$evidence" "${@:3}"
  if [[ "$action" == doctor || "$action" == hooks ]]; then "$helpers/hook-doctor" "$app" --data-dir "$scratch/desktop-data"; fi
  ;;
 cleanup) cleanup ;;
 *) echo 'Unknown action' >&2; exit 2 ;;
esac
