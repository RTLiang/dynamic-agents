#!/usr/bin/env python3
"""Isolated herdr integration API fixture; never edits real agent configuration."""
import json
from pathlib import Path
import socket
import sys

socket_path, evidence_path = sys.argv[1:]
evidence = Path(evidence_path)
rows = [
    {"target": "pi", "label": "Pi", "command": "pi", "available": True, "state": "current"},
    {"target": "codex", "label": "Codex", "command": "codex", "available": True, "state": "not_installed"},
    {"target": "claude", "label": "Claude Code", "command": "claude", "available": True, "state": "outdated"},
]

def save():
    (evidence / "integration-state.json").write_text(json.dumps(rows, indent=2) + "\n")

save()
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
    server.bind(socket_path)
    server.listen(4)
    while True:
        connection, _ = server.accept()
        with connection:
            connection.settimeout(3)
            data = b""
            while b"\n" not in data and len(data) < 65536:
                chunk = connection.recv(8192)
                if not chunk:
                    break
                data += chunk
            request = json.loads(data.split(b"\n", 1)[0])
            method = request.get("method")
            target = request.get("params", {}).get("target")
            before = next((row["state"] for row in rows if row["target"] == target), None)
            if method == "integration.list":
                response = {"result": {"type": "integration_list", "integrations": rows}}
            elif method in ("integration.install", "integration.uninstall") and before:
                for row in rows:
                    if row["target"] == target:
                        row["state"] = "current" if method == "integration.install" else "not_installed"
                save()
                response = {"result": {"type": method.replace(".", "_"), "target": target, "details": {"messages": ["Fixture configuration updated"]}}}
            else:
                response = {"error": {"code": "unsupported", "message": "Fixture request unsupported"}}
            response["id"] = request.get("id")
            after = next((row["state"] for row in rows if row["target"] == target), None)
            with (evidence / "integration-actions.jsonl").open("a") as log:
                log.write(json.dumps({"method": method, "target": target, "before": before, "after": after}) + "\n")
            connection.sendall((json.dumps(response) + "\n").encode())
